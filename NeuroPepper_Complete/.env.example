# ============================================
# NeuroPepper Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================

# === LOCAL AI SERVER (REQUIRED) ===
OLLAMA_BASE_URL=http://localhost:11434

# === PEPPER ROBOT CONNECTION ===
PEPPER_IP=192.168.1.100
PEPPER_PORT=9559
PEPPER_USERNAME=nao
PEPPER_PASSWORD=nao

# === SERVER SETTINGS ===
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG_MODE=true
LOG_LEVEL=INFO

# === OPTIONAL: Cloud AI Services ===
# Only fill these if you want to use cloud models

# OpenAI (for GPT-4, DALL-E)
OPENAI_API_KEY=

# Anthropic (for Claude)
ANTHROPIC_API_KEY=

# Google (for Gemini)
GOOGLE_API_KEY=

# DeepSeek Cloud API
DEEPSEEK_API_KEY=
DEEPSEEK_CLOUD_URL=https://api.deepseek.com/v1

# DeepSeek Local Server (your lab computer running DeepSeek)
# See docs/DEEPSEEK_SERVER_SETUP.md for setup instructions
DEEPSEEK_LOCAL_URL=http://localhost:8000/v1

# Stability AI (for image generation)
STABILITY_API_KEY=

# RunwayML (for video generation)
RUNWAYML_API_KEY=

# === USER PROFILES DATABASE ===
USER_PROFILE_DB=data/user_profiles/profiles.db

# === MEMORY SYSTEM ===
MEMORY_DB_PATH=data/memory.db
MEMORY_VECTOR_PATH=data/memory_vectors

# === RAG SYSTEM ===
VECTORSTORE_PATH=data/vectorstores
UPLOAD_FOLDER=data/uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# === SAFETY SETTINGS ===
MAX_ROBOT_SPEED=0.3
MAX_TRAVEL_DISTANCE=2.0
ENABLE_SAFETY_VALIDATOR=true

# === ADVANCED: Speech Processing ===
# Leave empty to use defaults
WHISPER_MODEL=base
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
